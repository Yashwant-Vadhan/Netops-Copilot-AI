# NetOps Copilot AI - Telemetry Collector Configuration

# Target host to probe via ping (e.g. 8.8.8.8, 1.1.1.1, or local default gateway)
TARGET_HOST=8.8.8.8

# Polling interval in seconds (default 5s)
POLL_INTERVAL_SECONDS=5

# Backend ingestion URL
BACKEND_URL=http://localhost:8000

# Shared collector secret header value (must match backend settings.COLLECTOR_SECRET)
COLLECTOR_SECRET=netops-collector-secret-key-2026

# Interface name to monitor (e.g., eth0, wlan0, Wi-Fi, Ethernet).
# Leave empty to autodetect active primary interface.
INTERFACE_NAME=

# Unique identifier for this collector instance (for multi-collector topology)
SOURCE_ID=collector-01
